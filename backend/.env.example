# development | test | production. Production refuses development secrets and DEBUG.
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-only-insecure-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://arara:arara@localhost:5436/arara
# Browser origin of the web app (trusted for CSRF)
WEB_ORIGIN=http://localhost:5174
LOG_LEVEL=INFO
